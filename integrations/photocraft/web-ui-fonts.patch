+type ServedUiFonts = Vec<(String, Arc<FontData>)>;
+
+/// Keep browser-served fallback faces in the context so language/theme changes do not
+/// discard them. These are appended, preserving Inter, named weights and icon fonts.
+pub fn install_served_ui_fonts(ctx: &egui::Context, delivered: &[(String, Vec<u8>)]) {
+    if delivered.is_empty() {
+        return;
+    }
+    let id = egui::Id::new("photocraft-served-ui-fonts");
+    let mut fonts = ctx.data(|d| d.get_temp::<ServedUiFonts>(id)).unwrap_or_default();
+    let mut changed = false;
+    for (family, bytes) in delivered {
+        let name = format!("served-ui-{family}");
+        if bytes.is_empty() || fonts.iter().any(|(existing, _)| existing == &name) {
+            continue;
+        }
+        fonts.push((name, Arc::new(FontData::from_owned(bytes.clone()))));
+        changed = true;
+    }
+    if changed {
+        ctx.data_mut(|d| d.insert_temp(id, fonts));
+        install_fonts(ctx);
+        ctx.request_repaint();
+    }
+}
